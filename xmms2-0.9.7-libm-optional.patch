--- xmms2-0.9.7/src/plugins/replaygain/wscript
+++ xmms2-0.9.7/src/plugins/replaygain/wscript
@@ -1,7 +1,12 @@
 from waftools.plugin import plugin
 
 def plugin_configure(conf):
-    conf.check_cc(lib="m", uselib_store="math")
+    # On some arches (e.g. aarch64) waf's libm probe can fail even though -lm works;
+    # force the link flag so the required replaygain plugin still builds.
+    if not conf.check_cc(lib="m", uselib_store="math", mandatory=False):
+        conf.env.LIB_math = ["m"]
+        conf.env.LIBPATH_math = []
+        conf.env.INCLUDES_math = []
 
 configure, build = plugin("replaygain", configure=plugin_configure,
                           libs=["math"])
